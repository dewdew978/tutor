// Prisma Schema for Multi-Tutor Video Course LMS Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String?
  image             String?
  role              String    @default("STUDENT") // "STUDENT" | "INSTRUCTOR" | "ADMIN"
  bio               String?
  headline          String?   // เช่น "อดีตตัวแทนโอลิมปิกวิชาการ / เกียรตินิยมอันดับ 1 วิศวะ จุฬาฯ"
  phoneNumber       String?
  socialLinks       String?   // JSON string
  
  // ข้อมูลบัญชีสำหรับรับเงินโอนของติวเตอร์
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  isVerifiedTutor   Boolean   @default(false)

  // Relations
  coursesCreated    Course[]            @relation("InstructorCourses")
  enrollments       Enrollment[]
  reviews           Review[]
  lessonProgress    LessonProgress[]
  questions         Question[]
  answers           Answer[]
  payouts           Payout[]
  tutorApplication  TutorApplication?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ใบสมัครขอเป็นติวเตอร์
model TutorApplication {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String            @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  resumeUrl          String?
  introVideoUrl      String?
  idCardUrl          String?
  educationHistory   String
  teachingExperience String
  subjectsToTeach    String
  adminFeedback      String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// หมวดหมู่วิชา
model Category {
  id          String    @id @default(cuid())
  name        String    // e.g. "คณิตศาสตร์", "ฟิสิกส์", "ภาษาอังกฤษ", "การเขียนโปรแกรม"
  slug        String    @unique
  icon        String?   // Lucide icon name or emoji
  description String?
  courses     Course[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// คอร์สเรียน
model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  subtitle         String?
  description      String
  coverImage       String?
  trailerVideoUrl  String?
  
  price            Float        @default(0)
  salePrice        Float?       // ราคาโปรโมชั่น
  level            String       @default("ALL_LEVELS") // "BEGINNER" | "INTERMEDIATE" | "ADVANCED" | "ALL_LEVELS"
  status           String       @default("DRAFT") // "DRAFT" | "PENDING_REVIEW" | "PUBLISHED" | "ARCHIVED"
  language         String       @default("th")
  
  // สิ่งที่จะได้รับ และ ข้อกำหนดก่อนเรียน (JSON String)
  whatYouWillLearn String?      // JSON array string
  requirements     String?      // JSON array string
  isFeatured       Boolean      @default(false)

  // Relations
  instructorId     String
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  
  categoryId       String?
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  chapters         Chapter[]
  enrollments      Enrollment[]
  reviews          Review[]
  questions        Question[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// บทเรียนหลัก (Chapter / Section)
model Chapter {
  id          String    @id @default(cuid())
  title       String
  description String?
  order       Int       @default(0)
  isPublished Boolean   @default(false)

  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons     Lesson[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// คลิปบทเรียนย่อย (Lesson)
model Lesson {
  id              String           @id @default(cuid())
  title           String
  description     String?
  
  // ข้อมูลวิดีโอ (รองรับ Cloudflare Stream, Mux, YouTube, หรือ S3)
  videoUrl        String?
  videoProvider   String?          @default("HTML5") // "CLOUDFLARE" | "MUX" | "YOUTUBE" | "S3" | "HTML5"
  videoDuration   Int              @default(0) // ความยาวเป็นวินาที (seconds)
  
  order           Int              @default(0)
  isFreePreview   Boolean          @default(false) // ให้ดูตัวอย่างฟรีหรือไม่
  isPublished     Boolean          @default(false)

  chapterId       String
  chapter         Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  attachments     Attachment[]
  userProgress    LessonProgress[]
  questions       Question[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ไฟล์เอกสารประกอบการเรียน (PDF, ชีทสรุป, โค้ดตัวอย่าง)
model Attachment {
  id          String    @id @default(cuid())
  name        String
  fileUrl     String
  fileType    String    // e.g. "application/pdf"
  fileSize    Int?      // bytes

  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// การลงทะเบียนเรียน / การซื้อคอร์ส
model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // ข้อมูลการเงิน
  amountPaid     Float     @default(0)
  currency       String    @default("THB")
  paymentMethod  String    @default("PROMPTPAY") // "PROMPTPAY" | "CREDIT_CARD" | "STRIPE" | "OMISE"
  paymentStatus  String    @default("COMPLETED") // "PENDING" | "COMPLETED" | "REFUNDED"
  paymentSlipUrl String?

  enrolledAt     DateTime  @default(now())

  @@unique([userId, courseId])
}

// บันทึกความก้าวหน้าการเรียนแต่ละคลิป
model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  isCompleted    Boolean   @default(false)
  lastPositionSec Int      @default(0) // วินาทีล่าสุดที่ดูค้างไว้ (Resume video)

  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([userId, lessonId])
}

// รีวิวและคะแนนคอร์ส
model Review {
  id        String    @id @default(cuid())
  rating    Int       @default(5) // 1 - 5 ดาว
  comment   String?

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, courseId])
}

// ถาม-ตอบข้อสงสัยใต้คลิป (Q&A)
model Question {
  id        String    @id @default(cuid())
  title     String
  content   String

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId  String?
  lesson    Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  answers   Answer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// คำตอบใน Q&A
model Answer {
  id          String    @id @default(cuid())
  content     String
  isByTutor   Boolean   @default(false) // เป็นคำตอบจากติวเตอร์ผู้สอนหรือไม่

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId  String
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// บันทึกการจ่ายเงินส่วนแบ่งให้ติวเตอร์
model Payout {
  id            String    @id @default(cuid())
  instructorId  String
  instructor    User      @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  amount        Float
  status        String    @default("PENDING") // "PENDING" | "PAID" | "REJECTED"
  paidAt        DateTime?
  referenceNote String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
